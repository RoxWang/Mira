#!/bin/zsh
# Mira 的实际干活部分：把视频交给浏览器播
# （默认用你系统的默认浏览器；想固定用某个见下面「用哪个浏览器打开」那段）
#
# 调用者：同目录的 AppleScript app（main.scpt）
#   - 访达右键「打开方式 → Mira」传文件进来 → on open
#   - 双击图标 → on run（不带参数）
#
# 为什么不用 --app 无边框模式：
#   --app 窗口没有菜单栏，而「实时字幕 Live Caption」的开关就在 Chrome 菜单里
#   （⋮ → 设置 → 无障碍）。没菜单就开不了字幕，那这个功能就废了。
#
# 为什么不用 ?src= 传路径：
#   Chrome 已经在跑的时候，open 把带查询串的 file:// URL 递过去会丢，页面收到的
#   是没有 src 的空页面（表现就是「还得手动拖一下」）。所以改成把路径直接写进
#   页面副本里，这条路跟 Chrome 跑没跑无关，稳。
#
# 播放列表 / 同名字幕 / 媒体参数也在同一步做完：file:// 页面读不到旁边的文件，
# 只有这里的脚本读得到，所以由 Resources/castgen.pl 一次读好、嵌进页面。
#
# 怎么把页面交给 Chrome（关键点，历史踩过坑）：
#   早期用 `open -a "Google Chrome" "file://..."`，有两个雷：
#     1) Chrome 已经在跑时，open 走 AppleEvent 把 URL 递过去，经常「只聚焦不打开」
#        或者开成空白页 —— 表现就是「双击/右键都打不开」。
#     2) Chrome 刚更新完的首次启动会自我重启（--restart），open 递来的 URL 在重启
#        交接时被丢掉，同样表现为打不开。
#   现在的做法：直接调 Chrome 二进制 + --new-window 把 URL 交给它。
#     - Chrome 没在跑：二进制直接拉起，URL 一定带得上。
#     - Chrome 已经在跑：Chrome 单实例会把 --new-window + URL 转发给正在跑的实例，
#       新开一个窗口并加载 URL，比 open 的 AppleEvent 稳得多。
#   `open -a "Google Chrome"`（不带 URL）只用来把窗口提到最前，确保真的看得见。
#
# 全程：不复制视频、不转码、不联网、不写缓存。
# 产物：$TMPDIR/Mira/play-<时间戳>.html（每次开视频一个新文件，各窗口互不串台；
#       只留最近 20 个，重启自动清）

set -u

APP_DIR="${0:A:h:h}"                       # Contents/MacOS/reel-launch → Contents
PAGE="$APP_DIR/Resources/view.html"
GEN="$APP_DIR/Resources/castgen.pl"

[[ -f "$PAGE" ]] || { echo "Mira 坏了：找不到 $PAGE"; exit 1; }

# ── 用哪个浏览器打开：默认跟着你系统的「默认网页浏览器」，不弹窗 ──
# 想固定用某一个，把 bundle id 写进下面这个文件的第一行（没有这个文件就是跟随系统）：
#   ~/Library/Application Support/Mira/browser
# 例如：com.google.Chrome 或 com.apple.Safari
# 为什么不做「启动时弹窗让你选」：绝大多数人不需要选，弹窗只会挡路。
# 想换浏览器本来就有一个正式的地方 —— 系统设置 → 桌面与程序坞 → 默认网页浏览器。
MIRA_PREF="$HOME/Library/Application Support/Mira/browser"

# 从 LaunchServices 里读系统默认浏览器。
# 优先看 macOS 12+ 那个专门的记录（系统设置里改默认浏览器写的就是它），
# 读不到再退回到 https 这个 URL scheme 的处理者。两处都是读不到就返回空，交给上层兜底。
default_browser_id() {
  local raw
  raw=$(/usr/bin/defaults read com.apple.LaunchServices/com.apple.launchservices.secure LSHandlers 2>/dev/null) || return 1
  print -r -- "$raw" | /usr/bin/perl -0777 -ne '
    my @b = split /\},\s*/, $_;
    for my $x (@b) {
      next unless $x =~ /default-app\.web-browser/;
      for my $i ($x =~ /LSHandlerRoleAll\s*=\s*"([^"]+)"/g) { next if $i eq "-"; print "$i\n"; exit }
    }
    for my $x (@b) {
      next unless $x =~ /LSHandlerURLScheme\s*=\s*https?;/;
      for my $i ($x =~ /LSHandlerRoleAll\s*=\s*"([^"]+)"/g) { next if $i eq "-"; print "$i\n"; exit }
    }
  '
}

# Chromium 系能直接「二进制 + --new-window」把 URL 递进去（比 open 稳，原因见文件头）。
# Safari / Firefox 不认这套参数，只能交给 LaunchServices，所以分开走。
chromium_bin() {
  local app=""
  case "${1:l}" in
    com.google.chrome)          app="Google Chrome.app/Contents/MacOS/Google Chrome" ;;
    com.microsoft.edgemac)      app="Microsoft Edge.app/Contents/MacOS/Microsoft Edge" ;;
    com.brave.browser)          app="Brave Browser.app/Contents/MacOS/Brave Browser" ;;
    com.vivaldi.vivaldi)        app="Vivaldi.app/Contents/MacOS/Vivaldi" ;;
    org.chromium.chromium)      app="Chromium.app/Contents/MacOS/Chromium" ;;
    company.thebrowser.browser) app="Arc.app/Contents/MacOS/Arc" ;;
    com.operasoftware.opera)    app="Opera.app/Contents/MacOS/Opera" ;;
    *) return 1 ;;
  esac
  local d
  for d in /Applications "$HOME/Applications"; do
    [[ -x "$d/$app" ]] && { print -r -- "$d/$app"; return 0 }
  done
  return 1
}

BROWSER_ID=""
if [[ -f "$MIRA_PREF" ]]; then
  BROWSER_ID=$(/usr/bin/head -1 "$MIRA_PREF" 2>/dev/null | /usr/bin/tr -d '[:space:]')
fi
[[ -n "$BROWSER_ID" ]] || BROWSER_ID=$(default_browser_id)
[[ -n "$BROWSER_ID" ]] || BROWSER_ID="com.google.Chrome"   # 实在读不到（全新系统）才兜这个底

# ── 把 URL 交给浏览器 ──
# Chromium 系：二进制 --new-window 保证「一定开新窗口并加载」，再用 open -b 提到最前；
# 其它浏览器：open -b 交给 LaunchServices；连 -b 都不认就退回系统默认（open 不带 -a）。
open_url() {
  local url="$1" bin
  if bin=$(chromium_bin "$BROWSER_ID"); then
    [[ "${MIRA_DRY:-0}" == "1" ]] && { print "DRY: \"$bin\" --new-window \"$url\""; return; }
    "$bin" --new-window "$url" >/dev/null 2>&1 &
    /usr/bin/open -b "$BROWSER_ID" >/dev/null 2>&1
    return
  fi
  [[ "${MIRA_DRY:-0}" == "1" ]] && { print "DRY: open -b \"$BROWSER_ID\" \"$url\""; return; }
  /usr/bin/open -b "$BROWSER_ID" "$url" >/dev/null 2>&1 || /usr/bin/open "$url" >/dev/null 2>&1
}

[[ "${MIRA_DRY:-0}" == "1" ]] && print "DRY: BROWSER_ID=$BROWSER_ID"

# ── 双击图标（没传文件）→ 开主页 ──
if [[ $# -eq 0 || -z "${1:-}" ]]; then
  open_url "file://$PAGE"
  exit 0
fi

F="${1:A}"
[[ -f "$F" ]] || { echo "Mira：这不是个文件 —— $F"; exit 1; }

WORK="${TMPDIR:-/tmp}/Mira"
/bin/mkdir -p "$WORK"
# 每次开视频都生成「独立」的播放页副本（各自的 __CAST__ 烧进页面），
# 这样每个窗口刷新都只认自己的那部，互不串台：以前共用 play.html，
# 先开 A 后开 B，回过头刷新 A 的窗口会被拽成 B。旧副本只留最近 20 个。
STAMP="$(/bin/date +%s)${$}"
OUT="$WORK/play-$STAMP.html"

# ── 主路：生成带「路径 + 播放列表 + 同名字幕 + 媒体参数」的页面副本 ──
# 注意：这里必须是**同步**的（不能用 nohup &），否则 main.scpt 收不到结果。
# castgen 内部列不出目录也只是退化成「只有这一部」，绝不会交回一个空页面。
if [[ -f "$GEN" ]] && GENOUT=$(/usr/bin/perl "$GEN" "$PAGE" "$F" "$OUT" 2>/dev/null) && [[ -s "$OUT" ]]; then
  # 目录被 macOS 隐私权限挡住 → 只在本次开机提醒一次
  # （标记文件放在 $TMPDIR 里，重启自动消失，不在硬盘上留东西）
  if [[ "$GENOUT" == *BLOCKED* && ! -f "$WORK/.asked" ]]; then
    : > "$WORK/.asked"
    echo "BLOCKED"
  fi
  open_url "file://$OUT"
  # 清掉多余旧副本（保留最新 20 个），别让 $TMPDIR 越积越多
  n=$(/bin/ls -1t "$WORK"/play-*.html 2>/dev/null | /usr/bin/wc -l | /usr/bin/tr -d ' ')
  if (( n > 20 )); then
    /bin/ls -1t "$WORK"/play-*.html 2>/dev/null | /usr/bin/tail -n +21 | while read -r f; do /bin/rm -f "$f"; done
  fi
  exit 0
fi

# ── 兜底：生成本身都失败了（页面模板坏了）──
# 这里**不再**用 ?src= 传路径：Chrome 已经在跑的时候，带查询串的 file:// URL
# 递过去查询串会丢，页面收到的是没有 src 的空页面 ——
# 「打开是个网页，还得手动把视频添加进去」就是这么来的。
open_url "file://$PAGE"
exit 0
